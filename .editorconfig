root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,ps1,psd1,py}]
indent_style = space
indent_size = 4

[*.cs]
csharp_new_line_before_open_brace = all

# Markdown uses two trailing spaces for a hard line break.
[*.md]
trim_trailing_whitespace = false
