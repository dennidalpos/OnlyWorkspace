<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net10.0-windows</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>OnlyWorkspace.Infrastructure</RootNamespace>
    <AssemblyName>OnlyWorkspace.Infrastructure</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OnlyWorkspace.Core\OnlyWorkspace.Core.csproj" />
    <InternalsVisibleTo Include="OnlyWorkspace.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <!-- Mail archive: SQLite encrypted as a whole (SQLite3 Multiple Ciphers). One SQLitePCLRaw bundle only. -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.13" />
    <PackageReference Include="SQLite3MC.PCLRaw.bundle" Version="2.6.1" />
  </ItemGroup>

  <!-- net48 has no runtime identifier: ship both native builds, ArchiveDb loads the one matching the Outlook bitness. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="SQLite3MC.PCLRaw.lib" Version="2.6.1" GeneratePathProperty="true" ExcludeAssets="native;runtime" />
    <None Include="$(PkgSQLite3MC_PCLRaw_lib)\runtimes\win-x64\native\sqlite3mc.dll" Link="runtimes\win-x64\native\sqlite3mc.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(PkgSQLite3MC_PCLRaw_lib)\runtimes\win-x86\native\sqlite3mc.dll" Link="runtimes\win-x86\native\sqlite3mc.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <PackageReference Include="System.Text.Json" Version="10.0.13" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.13" />
    <!-- Serilog asks for 8.0.x of these two (out of support with .NET 8): same servicing line as System.Text.Json. -->
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="10.0.13" />
    <PackageReference Include="System.Threading.Channels" Version="10.0.13" />
    <Reference Include="System.Security" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
  </ItemGroup>
</Project>
