<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <Platforms>AnyCPU</Platforms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>OnlyWorkspace.Outlook</RootNamespace>
    <AssemblyName>OnlyWorkspace.Outlook</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Office.Interop.Outlook" Version="15.0.4797.1004">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Office.Interop.Word" Version="15.0.4797.1004">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OnlyWorkspace.Core\OnlyWorkspace.Core.csproj" />
    <ProjectReference Include="..\OnlyWorkspace.Infrastructure\OnlyWorkspace.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="UI\TaskPane.html" LogicalName="OnlyWorkspace.Outlook.UI.TaskPane.html" />
    <EmbeddedResource Include="UI\ribbon-icon-16.png" LogicalName="OnlyWorkspace.Outlook.UI.ribbon-icon-16.png" />
    <EmbeddedResource Include="UI\ribbon-icon-32.png" LogicalName="OnlyWorkspace.Outlook.UI.ribbon-icon-32.png" />
    <!-- PromptCatalog loads prompts\ next to OnlyWorkspace.Core.dll: the build output has the installed layout. -->
    <Content Include="..\..\prompts\*.json" Link="prompts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <!-- WinForms host only: on net48 the WebView2 package also copies its WPF assembly. -->
  <!-- PackageReference metadata does not reach ReferencePath. Apply No-PIA to compiler inputs.
       https://learn.microsoft.com/en-us/nuget/create-packages/author-packages-with-com-interop-assemblies -->
  <Target Name="EmbedOfficeInteropTypes" AfterTargets="ResolveReferences" BeforeTargets="FindReferenceAssembliesForReferences">
    <ItemGroup>
      <ReferencePath Condition="'%(ReferencePath.NuGetPackageId)' == 'Microsoft.Office.Interop.Outlook' Or '%(ReferencePath.NuGetPackageId)' == 'Microsoft.Office.Interop.Word'">
        <EmbedInteropTypes>true</EmbedInteropTypes>
      </ReferencePath>
    </ItemGroup>
  </Target>

  <Target Name="DropWebView2Wpf" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
</Project>
