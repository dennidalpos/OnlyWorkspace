{
  "Revision": "2",
  "NamePattern": "(?<name>\\p{Lu}[\\p{L}'’\\-]+(?:[ \\t]+(?:d[aeiu]|de|del|della|van|von|di|la|le|\\p{Lu}[\\p{L}'’\\-]+)){1,3})[ \\t]*[<(\\[]\\s*(?<email>[A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,})",
  "NameOpeners": ["Da", "A", "Cc", "Ccn", "Per", "From", "To", "Gentile", "Gentili", "Caro", "Cara", "Cari", "Egregio", "Egregia", "Spett", "Spettabile", "Dear", "Hi", "Hello", "Ciao", "Salve", "Buongiorno", "Buonasera", "Dott", "Dott.ssa", "Ing", "Avv", "Sig", "Sig.ra", "Mittente", "Destinatario"],
  "Patterns": [
    {"Id":"iban", "Category":"IBAN", "Priority":100, "Pattern":"\\b(?<value>[A-Z]{2}\\d{2}(?:[ ]?[A-Z0-9]){11,30})\\b"},
    {"Id":"tax-code", "Category":"CF", "Priority":100, "Pattern":"\\b(?<value>[A-Za-z]{6}\\d{2}[A-Za-z]\\d{2}[A-Za-z]\\d{3}[A-Za-z])\\b"},
    {"Id":"email", "Category":"EMAIL", "Priority":100, "Pattern":"(?<value>[A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,})"},
    {"Id":"vat", "Category":"PIVA", "Priority":90, "Pattern":"\\b(?<value>(?:IT)?\\d{11})\\b"},
    {"Id":"phone", "Category":"TEL", "Priority":80, "Pattern":"(?<![\\w/]|\\d[.,])(?<value>(?:(?:\\+|00)\\d{1,3}[ .\\-]?)?(?:3\\d{2}|0\\d{1,3})[ .\\-]?\\d{3,4}[ .\\-]?\\d{3,4})(?![\\w/]|[.,]\\d)"},
    {"Id":"case-reference", "Category":"PRATICA", "Priority":70, "Pattern":"(?i:\\b(?:pratica|protocollo|fascicolo|rif(?:erimento)?\\.)[ \\t:#-]+)(?<value>[A-Za-z0-9]+(?:[-/][A-Za-z0-9]+)+)\\b"},
    {"Id":"amount", "Category":"IMPORTO", "Priority":60, "Option":"amounts", "Pattern":"(?<value>(?:EUR|USD|GBP|€|\\$|£)[ \\t]*\\d[\\d.,]*|\\b\\d[\\d.,]*[ \\t]*(?:EUR|USD|GBP|€|\\$|£))"},
    {"Id":"date", "Category":"DATA", "Priority":60, "Option":"dates", "Pattern":"(?<!\\w)(?<value>(?:0?[1-9]|[12]\\d|3[01])[/.-](?:0?[1-9]|1[0-2])[/.-](?:19|20)\\d{2}|(?:19|20)\\d{2}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01]))(?!\\w)"}
  ]
}
