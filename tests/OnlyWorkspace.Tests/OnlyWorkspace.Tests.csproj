<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net48 is what the installer ships; net10 keeps the modern runtime covered. -->
    <TargetFrameworks>net48;net10.0-windows</TargetFrameworks>
    <!-- Both targets exercise the same interactive desktop; xUnit collections only serialize within one host. -->
    <TestTfmsInParallel>false</TestTfmsInParallel>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <!-- Same version as the extractor: writes the .msg given to it by AttachmentExtractionTests. -->
    <PackageReference Include="OpenMcdf" Version="3.3.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <!-- No shadow copy: ArchiveDb and the CLI tests resolve native SQLite and the ConfigTool exe next to the assemblies. -->
  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\fixtures\fidelity\*.json" Link="fidelity\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Same layout as the installation: PromptCatalog loads prompts\ next to OnlyWorkspace.Core.dll. -->
    <Content Include="..\..\prompts\*.json" Link="prompts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\OnlyWorkspace.Outlook\UI\EmbeddedPageBoundary.cs" Link="EmbeddedPageBoundary.cs" />
    <Compile Include="..\..\src\OnlyWorkspace.Outlook\Ribbon\RibbonXml.cs" Link="Outlook\RibbonXml.cs" />
    <!-- COM-free indexer and its seam: ArchiveIndexerInterruptionTests stand in for Outlook. -->
    <Compile Include="..\..\src\OnlyWorkspace.Outlook\Services\ArchiveIndexer.cs" Link="Outlook\ArchiveIndexer.cs" />
    <Compile Include="..\..\src\OnlyWorkspace.Outlook\Services\IArchiveMailSource.cs" Link="Outlook\IArchiveMailSource.cs" />
    <Compile Include="..\..\src\OnlyWorkspace.Outlook\Services\WatchedArchiveMailSource.cs" Link="Outlook\WatchedArchiveMailSource.cs" />
    <Compile Include="..\..\src\OnlyWorkspace.Outlook\Services\StoreListCache.cs" Link="Outlook\StoreListCache.cs" />
    <Compile Include="..\..\src\OnlyWorkspace.Outlook\Services\UiSlice.cs" Link="Outlook\UiSlice.cs" />
    <Compile Include="..\..\src\OnlyWorkspace.Outlook\Services\ArchiveColumnProbe.cs" Link="Outlook\ArchiveColumnProbe.cs" />
    <Compile Include="..\..\src\OnlyWorkspace.Outlook\Services\AttachmentCopies.cs" Link="Outlook\AttachmentCopies.cs" />
    <Compile Include="..\..\src\OnlyWorkspace.Outlook\Services\ConfigToolLauncher.cs" Link="Outlook\ConfigToolLauncher.cs" />
    <Compile Include="..\..\src\OnlyWorkspace.Outlook\UI\UiSync.cs" Link="Outlook\UiSync.cs" />
    <Compile Include="..\..\src\OnlyWorkspace.Outlook\Services\UiThreadWatch.cs" Link="Outlook\UiThreadWatch.cs" />
    <Compile Include="..\..\src\OnlyWorkspace.Outlook\SessionStart.cs" Link="Outlook\SessionStart.cs" />
    <!-- COM-free part of TaskPaneCoordinator's dispatch: PaneDispatchConsentTests drive it with the real indexer. -->
    <Compile Include="..\..\src\OnlyWorkspace.Outlook\UI\PaneArchiveCommands.cs" Link="Outlook\PaneArchiveCommands.cs" />
    <!-- Interrompi against the other cancels of the pane: PaneOperationsTests. -->
    <Compile Include="..\..\src\OnlyWorkspace.Outlook\UI\PaneOperations.cs" Link="Outlook\PaneOperations.cs" />
    <Compile Include="..\..\src\OnlyWorkspace.Outlook\UI\TurnWebSources.cs" Link="Outlook\TurnWebSources.cs" />
    <!-- Evidence reading of the chat and Cerca e analizza: MailEvidenceReaderTests. -->
    <Compile Include="..\..\src\OnlyWorkspace.Outlook\UI\MailEvidenceReader.cs" Link="Outlook\MailEvidenceReader.cs" />
    <Compile Include="..\..\src\OnlyWorkspace.Outlook\UI\AnalysisFinalization.cs" Link="Outlook\AnalysisFinalization.cs" />
    <!-- Running work replayed to a page loaded again and listed by the other windows' panes: PaneJobsTests. -->
    <Compile Include="..\..\src\OnlyWorkspace.Outlook\UI\PaneJobs.cs" Link="Outlook\PaneJobs.cs" />
    <!-- The extractor runs as its own process; its STA helper is tested here directly: StaThreadTests. -->
    <Compile Include="..\..\src\OnlyWorkspace.AttachmentExtractor\StaThread.cs" Link="Extractor\StaThread.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OnlyWorkspace.Core\OnlyWorkspace.Core.csproj" />
    <ProjectReference Include="..\..\src\OnlyWorkspace.Infrastructure\OnlyWorkspace.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\OnlyWorkspace.ConfigTool\OnlyWorkspace.ConfigTool.csproj" />
    <!-- Helper exe uses its own net48 target. Do not pass a global TargetFramework:
         solution and test builds must share one project instance and its output files. -->
    <ProjectReference Include="..\..\src\OnlyWorkspace.AttachmentExtractor\OnlyWorkspace.AttachmentExtractor.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" GlobalPropertiesToRemove="TargetFramework" />
    <!-- Build order only: InteropPackageTests reads the add-in built by this run, not one left by an earlier build. -->
    <ProjectReference Include="..\..\src\OnlyWorkspace.Outlook\OnlyWorkspace.Outlook.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" GlobalPropertiesToRemove="TargetFramework" />
  </ItemGroup>

  <!-- WebView2 flows in from the ConfigTool with its WPF reference (net10, build/Common.targets): WinForms only, as there. -->
  <Target Name="DropWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

  <!-- Same layout as the installation: "extractor" next to the assemblies. -->
  <Target Name="CopyExtractor" AfterTargets="Build" Condition="'$(TargetFramework)' != ''">
    <ItemGroup>
      <ExtractorFiles Include="..\..\src\OnlyWorkspace.AttachmentExtractor\bin\$(Configuration)\net48\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ExtractorFiles)" DestinationFolder="$(OutDir)extractor" SkipUnchangedFiles="true" />
  </Target>

</Project>
