{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-paths.cjs\"",
            "timeout": 10,
            "statusMessage": "Controllo percorsi protetti"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-pane-js.cjs\"",
            "timeout": 30,
            "statusMessage": "Controllo sintassi JavaScript"
          }
        ]
      }
    ]
  }
}
